    "modalStep4": {
        "message": "<strong>No Gemini Account Needed:</strong> Access to the Gemini API is managed through your Google account."
    },
    "modalStep5": {
        "message": "<strong>No Payment Required Initially:</strong> You can start using the Gemini API without entering payment information."
    },
    "modalStep6": {
        "message": "<strong>Use the Free Tier:</strong> The free tier is limited to 25 requests/day."
    },
    "modalStep7": {
        "message": "<strong>Upgrade if Needed:</strong> If usage exceeds free limits, set up a billing account to upgrade to a paid plan with higher rate limits."
    },
