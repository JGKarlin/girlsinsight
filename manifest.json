{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.5.0",
  "description": "__MSG_appDescription__",
  "default_locale": "ja",
  "permissions": [
    "storage",
    "downloads",
    "sidePanel",
    "contextMenus",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://girlschannel.net/*",
    "https://www.girlschannel.net/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://girlschannel.net/*",
        "https://www.girlschannel.net/*"
      ],
      "js": ["girlschannel-parsing.js", "content.js"]
    }
  ],
  "action": {
    "default_title": "GirlsinSight"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
